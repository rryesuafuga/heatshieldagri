# R session
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# intermediate model objects (rebuilt by run_all.R; dat.rds contains the GPL dataset)
outputs/*.rds

# JSON for the web page: CI copies it into web/frontend/public/dlnm/ instead
outputs/web/

# rmarkdown by-products
report/*.html
report/report_files/

# renv library (commit renv.lock, not the library)
renv/library/
renv/staging/

# generated synthetic data (rebuilt by data-raw/make_synthetic_dhs.R)
data-raw/synthetic/

# copies of outputs made only for bundling the Shiny app (see app/app.R header)
app/outputs/
app/www/figs/

# Shinylive export (rebuilt by CI)
site/

# belt and braces: restricted data formats never belong here
*.dta
*.sav
*.DHS
data/restricted/

# raw GPS / cluster coordinates from real surveys
*.shp
*.shx
*.dbf
*GPS*.csv
*GE*.zip
